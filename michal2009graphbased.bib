@inproceedings{michal2009graphbased,
author = {Michal Valko},
title = {{Graph-Based Anomaly Detection with Soft Harmonic Functions}},
booktitle = {Neural Information Processing Systems},
year = {2009},
abstract = {We develop a non-parametric approach for conditional anomaly detection based on soft harmonic solutions, estimating label confidence to detect anomalous mislabeling. We regularize to avoid detecting isolated examples and boundary cases.}
