@inproceedings{popineau2019optimizing,
  abstract = {Proceedings of the Workshop on Optimizing Human Learning, eliciting Adaptive Sequences for Learning (WeASeL), held in conjunction with ITS 2019. The workshop focused on the intersection of machine learning and human learning, exploring how adaptive sequencing algorithms can optimize educational content delivery.},
  author = {Fabrice Popineau and Michal Valko and Jill-Jênn Vie},
  booktitle = {CEUR 2019},
