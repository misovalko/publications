@article{domingues2024rlberry,
  abstract = {rlberry is a Python library for reinforcement learning (RL) designed for research and education. It provides a flexible and modular framework for implementing, evaluating, and comparing RL algorithms. The library supports various types of environments and agents, and includes tools for experiment management, reproducibility, and statistical analysis of results.},
  author = {Omar Darwiche Domingues and Yannis Flet-Berliac and Edouard Leurent and Pierre Ménard and Xuedong Shang and Michal Valko},
  title = {{rlberry: A Reinforcement Learning Library for Research and Education}},
  url = {https://misovalko.github.io/publications/domingues2024rlberry.pdf},
  year = {2024}
}
